{
 "app": "numbers",
 "tool": "Echo numbers",
 "register": [
  {
   "name": "numbers",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/numbers_app"
   ]
  }
 ],
 "conformance": [
  "NUM-03"
 ],
 "script_macro": "app=numbers tool=[Echo numbers] n=-9007199254740992 x=0 m=1",
 "script_mode_only": true,
 "expect": {
  "absent_keys": [
   "status",
   "request",
   "worker_alive_after",
   "run_record"
  ],
  "at": {
   "retention.runs.count": 0
  },
  "equals": {
   "error": "'N' must be >= -9007199254740991, got -9007199254740992"
  }
 }
}
