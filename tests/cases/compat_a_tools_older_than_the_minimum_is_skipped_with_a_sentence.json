{
 "app": "victim",
 "tool": "Scalar echo",
 "register": [
  {
   "name": "victim",
   "prefix": "${PREFIX}",
   "module": "labconstrictor_tools.examples.synthetic",
   "pythonpath": []
  }
 ],
 "tamper": [
  {
   "app": "victim",
   "schema_replace": [
    "\"tools_version\": \"0.3.0a1\"",
    "\"tools_version\": \"0.2.0rc1\""
   ]
  }
 ],
 "expect": {
  "equals": {
   "error": "no apps registered"
  },
  "log_contains": [
   "app skipped: victim: ignored: this app's labconstrictor-tools 0.2.0rc1 is older than the 0.3.0a1 this host needs: update it"
  ]
 }
}
