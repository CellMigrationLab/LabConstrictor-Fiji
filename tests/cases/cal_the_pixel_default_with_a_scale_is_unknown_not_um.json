{
 "app": "calibration",
 "tool": "Pixel size required",
 "register": [
  {
   "name": "calibration",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/calibration_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/sample.tif",
   "title": "p.tif",
   "pixel_width": 0.25,
   "unit": "pixel"
  }
 ],
 "select": [
  "p.tif"
 ],
 "overrides": {
  "image": "p.tif"
 },
 "script_mode_only": true,
 "expect": {
  "at": {
   "calibration_states_initial.pixel_size": {
    "state": "unset"
   },
   "error": "'pixel_size' needs a value: 'image' has no pixel size. Enter it in um.",
   "request": "$absent"
  }
 },
 "conformance": [
  "CAL-04",
  "CAL-08"
 ]
}
