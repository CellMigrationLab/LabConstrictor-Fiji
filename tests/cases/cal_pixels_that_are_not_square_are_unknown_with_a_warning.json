{
 "app": "calibration",
 "tool": "Pixel size required",
 "register": [
  {
   "name": "calibration",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/calibration_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/sample.tif",
   "title": "n.tif",
   "pixel_width": 0.5,
   "pixel_height": 0.25,
   "unit": "um"
  }
 ],
 "select": [
  "n.tif"
 ],
 "overrides": {
  "image": "n.tif"
 },
 "script_mode_only": true,
 "expect": {
  "at": {
   "calibration_states_initial.pixel_size": {
    "state": "unset"
   },
   "error": "'pixel_size' needs a value: 'image' has no pixel size. Enter it in um."
  },
  "log_contains": [
   "image: pixels are not square"
  ]
 },
 "conformance": [
  "CAL-06"
 ]
}
