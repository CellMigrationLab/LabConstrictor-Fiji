{
 "app": "calibration",
 "tool": "Pixel size required",
 "register": [
  {
   "name": "calibration",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/calibration_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/sample.tif",
   "title": "a.tif",
   "pixel_size": 0.25
  }
 ],
 "expect": {
  "status": "COMPLETE",
  "at": {
   "request.pixel_size": 0.3,
   "request._calibration.pixel_size": {
    "of": "image",
    "source": "user",
    "axes": {
     "x": {
      "value": 0.3,
      "unit": "um",
      "source": "user"
     },
     "y": {
      "value": 0.3,
      "unit": "um",
      "source": "user"
     }
    }
   }
  }
 },
 "conformance": [
  "CAL-T3"
 ],
 "macro": "app=calibration tool=[Pixel size required] image=a.tif pixel_size=0.3"
}
