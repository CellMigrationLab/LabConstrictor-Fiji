{
 "app": "adv",
 "tool": "Outlines",
 "register": [
  {
   "name": "adv",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/adversarial_app"
   ]
  }
 ],
 "preload": [
  {
