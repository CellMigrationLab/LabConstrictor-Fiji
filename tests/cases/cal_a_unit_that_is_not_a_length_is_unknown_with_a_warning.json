{
 "app": "calibration",
 "tool": "Pixel size required",
 "register": [
  {
   "name": "calibration",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/calibration_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/sample.tif",
   "title": "s.tif",
   "pixel_width": 1.0,
   "unit": "second"
  }
 ],
 "select": [
  "s.tif"
 ],
 "overrides": {
  "image": "s.tif"
 },
 "script_mode_only": true,
 "expect": {
  "at": {
   "error": "'pixel_size' needs a value: 'image' has no pixel size. Enter it in um."
  },
  "log_contains": [
   "image: unit 'second' is not a length"
  ]
 },
 "conformance": [
  "CAL-07"
 ]
}
