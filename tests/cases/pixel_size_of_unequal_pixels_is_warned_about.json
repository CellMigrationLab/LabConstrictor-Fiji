{
 "app": "parity",
 "tool": "Calibrated",
 "register": [
  {
   "name": "parity",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/parity_app"
   ]
  }
 ],
 "overrides": {
  "image_file": "${FIXTURES}/anisotropic.tif"
 },
 "expect": {
  "at": {
   "error": "'scale' needs a value: 'image' has no pixel size. Enter it in um.",
   "request": "$absent",
   "calibration_states_initial.scale": {
    "state": "unset"
   }
  },
  "log_contains": [
   "image: pixels are not square"
  ]
 }
}
