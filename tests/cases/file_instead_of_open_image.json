{
 "app": "synthetic",
 "tool": "Image stats",
 "preload": [
  {
   "path": "${FIXTURES}/sample.tif",
   "title": "reference.tif",
   "pixel_size": 0.65
  }
 ],
 "select": [
  "reference.tif"
 ],
 "overrides": {
  "image": "reference.tif",
  "image_file": "${FIXTURES}/sample.tif"
 },
 "expect": {
  "status": "COMPLETE",
  "match": {
   "request.image": "/fixtures/sample.tif"
  }
 }
}