{
 "app": "calibration",
 "tool": "Pixel size required",
 "register": [
  {
   "name": "calibration",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/calibration_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/sample.tif",
   "title": "a.tif",
   "pixel_size": 0.25
  }
 ],
 "select": [
  "a.tif"
 ],
 "overrides": {
  "image": "a.tif"
 },
 "script_mode_only": true,
 "expect": {
  "status": "COMPLETE",
  "at": {
   "steps": [
    [
     0.0
    ],
    [
     0.25
    ]
   ],
   "request.pixel_size": 0.25,
   "calibration_states.pixel_size": {
    "state": "auto",
    "value": 0.25,
    "source": "image"
   },
   "request._calibration.pixel_size.source": "image"
  }
 },
 "dialog_steps": [
  {
   "file": "${FIXTURES}/sample.tif"
  },
  {
   "file": ""
  }
 ],
 "conformance": [
  "CAL-T6"
 ]
}
