{
 "app": "frames",
 "tool": "Labels of the same size",
 "register": [
  {
   "name": "frames",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/frames_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/ASYM.tif",
   "title": "ASYM.tif",
   "pixel_width": 0.25,
   "pixel_height": 0.5,
   "x_origin": -80.0,
   "y_origin": -20.0,
   "unit": "um"
  }
 ],
 "select": [
  "ASYM.tif"
 ],
 "overrides": {
  "image": "ASYM.tif"
 },
 "script_mode_only": true,
 "expect": {
  "status": "COMPLETE",
  "absent_keys": [
   "size_mismatch_lab"
  ],
  "at": {
   "windows.frames_lab.calibration": {
    "pixel_width": 0.25,
    "pixel_height": 0.5,
    "unit": "\u00b5m",
    "x_origin": -80.0,
    "y_origin": -20.0
   }
  }
 },
 "conformance": [
  "CF-03"
 ]
}
