{
 "app": "crashy",
 "register": [
  {
   "name": "crashy",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/crashy_app"
   ]
  }
 ],
 "tool": "Raises with a traceback",
 "expect": {
  "status": "FAILED",
  "match": {
   "failure_message": "ZeroDivisionError"
  },
  "absent": {
   "failure_message": [
    "[SERVICE-"
   ]
  },
  "log_contains": [
   "fiji: ---- session start",
   "fiji: starting worker for crashy",
   "fiji: worker",
   "ZeroDivisionError",
   "fiji: task FAILED tool=raises"
  ]
 }
}