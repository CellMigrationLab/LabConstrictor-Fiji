{
 "app": "parity",
 "tool": "Typed choices",
 "register": [
  {
   "name": "parity",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/parity_app"
   ]
  }
 ],
 "runs_prefill": 52,
 "expect": {
  "status": "COMPLETE",
