{
 "app": "lookups",
 "tool": "Blocks",
 "register": [
  {
   "name": "lookups",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/lookups_app"
   ]
  }
 ],
 "overrides": {
  "seconds": 60.0
 },
 "worker_pidfile": true,
 "cancel_when_worker_started": true,
 "worker_gone_within_s": 2,
 "expect": {
  "status": "CRASHED",
  "equals": {
   "status_line": "LabConstrictor: cancelled (worker stopped)",
   "worker_gone": true
  },
  "log_contains": [
   "the run was cancelled (worker stopped) (Cancel was pressed)"
  ],
  "absent_keys": [
   "failure_message"
  ],
  "worker_alive_after": false
 }
}
