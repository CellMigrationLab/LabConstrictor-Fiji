{
 "app": "victim",
 "tool": "Scalar echo",
 "register": [
  {
   "name": "victim",
   "prefix": "${PREFIX}",
   "module": "labconstrictor_tools.examples.synthetic",
   "pythonpath": []
  }
 ],
 "tamper": [
  {
   "schema_replace": [
    "\"type\": \"float\"",
    "\"type\": \"imagge\""
   ],
   "app": "victim"
  }
 ],
 "expect": {
  "equals": {
   "error": "no apps registered"
  },
  "log_contains": [
   "app skipped: ",
   "unsupported type imagge"
  ]
 }
}
