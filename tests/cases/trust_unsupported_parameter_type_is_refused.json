{
 "app": "victim",
 "tool": "Scalar echo",
 "register": [
  {
   "name": "victim",
   "prefix": "${PREFIX}",
   "module": "labconstrictor_tools.examples.synthetic",
   "pythonpath": []
  }
 ],
 "tamper": [
  {
   "schema_replace": [
    "\"default\": 1.0,\n          \"type\": \"float\"",
    "\"default\": 1.0,\n          \"type\": \"imagge\""
   ],
   "app": "victim"
  }
 ],
 "expect": {
  "log_contains": [
   "app skipped: ",
   "tool 'scalar_echo': this tool cannot be shown: parameter 'a' has the unknown type 'imagge'"
  ]
 }
}
