{
 "app": "frames",
 "tool": "Labels of half the size",
 "register": [
  {
   "name": "frames",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/frames_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/ASYM.tif",
   "title": "ASYM.tif",
   "pixel_width": 0.25,
   "pixel_height": 0.5,
   "x_origin": -80.0,
   "y_origin": -20.0,
   "unit": "um"
  }
 ],
 "select": [
  "ASYM.tif"
 ],
 "overrides": {
  "image": "ASYM.tif"
 },
 "script_mode_only": true,
 "expect": {
  "status": "COMPLETE",
  "at": {
   "size_mismatch_lab": "'lab' is 6 x 4 but 'ASYM.tif' was exported as 12 x 8; shown at the pixel origin, not aligned",
   "windows.frames_lab.calibration": {
    "pixel_width": 1.0,
    "pixel_height": 1.0,
    "unit": " ",
    "x_origin": 0.0,
    "y_origin": 0.0
   }
  },
  "log_contains": [
   "'lab' is 6 x 4 but 'ASYM.tif' was exported as 12 x 8; shown at the pixel origin, not aligned"
  ]
 },
 "conformance": [
  "CF-11"
 ]
}
