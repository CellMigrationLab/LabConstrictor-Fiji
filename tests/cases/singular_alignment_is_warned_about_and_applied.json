{
 "app": "affine",
 "tool": "Singular alignment",
 "register": [
  {
   "name": "affine",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/affine_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/sample.tif",
   "title": "sample.tif",
   "pixel_size": 0.5
  }
 ],
 "expect": {
  "status": "COMPLETE",
  "log_contains": [
   "the alignment matrix is singular",
   "collapses onto a line or a point"
  ],
  "equals": {
   "open_windows": [
    "sample.tif",
    "Alignment overlay (green = , magenta = image)"
   ]
  }
 }
}
