{"app": "interactions", "tool": "Find bright spots",
 "register": [{"name": "interactions", "prefix": "${PREFIX}", "module": "labconstrictor_tools.examples.interactions", "pythonpath": []}],
 "preload": [{"path": "${FIXTURES}/sample.tif", "title": "query.tif", "pixel_size": 0.325}],
 "select": ["query.tif"],
 "overrides": {"image": "query.tif", "threshold": 0.5, "look_for": "dark"},
 "final_screenshot": true,
 "script_mode_only": true,
 "expect": {"status": "COMPLETE",
            "equals": {"dialog_styles": {"threshold": "slider", "look_for": "radioButtonHorizontal"}}}}
