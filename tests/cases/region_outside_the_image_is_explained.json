{
 "app": "interactions",
 "tool": "Find bright spots",
 "register": [
  {
   "name": "interactions",
   "prefix": "${PREFIX}",
   "module": "labconstrictor_tools.examples.interactions",
   "pythonpath": []
  }
 ],
 "script_mode_only": true,
 "preload": [
  {
   "path": "${FIXTURES}/blobs.tif",
   "title": "blobs.tif",
   "roi": [
    200,
    200,
    10,
    10
   ]
  }
 ],
 "select": [
  "blobs.tif"
 ],
 "overrides": {
  "image": "blobs.tif",
  "threshold": 0.5,
  "selection_region": true
 },
 "expect": {
  "match": {
   "error": "outside the image"
  }
 }
}