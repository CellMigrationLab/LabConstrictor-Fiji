{
 "app": "numbers",
 "tool": "Echo numbers",
 "register": [
  {
   "name": "numbers",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/numbers_app"
   ]
  }
 ],
 "conformance": [
  "NUM-05"
 ],
 "script_macro": "app=numbers tool=[Echo numbers] n=1 x=0 m=11",
 "script_mode_only": true,
 "expect": {
  "absent_keys": [
   "status",
   "request",
   "worker_alive_after",
   "run_record"
  ],
  "at": {
   "retention.runs.count": 0
  },
  "equals": {
   "error": "'M' must be <= 10, got 11"
  }
 }
}
