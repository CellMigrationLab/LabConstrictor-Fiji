{
 "app": "frames",
 "tool": "Labels that replace",
 "register": [
  {
   "name": "frames",
   "prefix": "${PREFIX}",
   "module": "tools",
   "pythonpath": [
    "${V3}/tests/frames_app"
   ]
  }
 ],
 "preload": [
  {
   "path": "${FIXTURES}/ASYM.tif",
   "title": "ASYM.tif"
  },
  {
   "path": "${FIXTURES}/ASYM.tif",
   "title": "frames:lab",
   "pixel_width": 0.5,
   "x_origin": -100.0,
   "unit": "um"
  }
 ],
 "select": [
  "ASYM.tif"
 ],
 "overrides": {
  "image": "ASYM.tif"
 },
 "script_mode_only": true,
 "expect": {
  "status": "COMPLETE",
  "at": {
   "windows.frames_lab.calibration": {
    "pixel_width": 1.0,
    "pixel_height": 1.0,
    "unit": " ",
    "x_origin": 0.0,
    "y_origin": 0.0
   }
  },
  "equals": {
   "open_windows": [
    "ASYM.tif",
    "frames:lab"
   ]
  }
 },
 "conformance": [
  "CF-12"
 ]
}
