    }
   }
  }
 },
 {
  "tool": "kitchen_sink",
  "inputs": {
   "required_string": "hello",
   "image": "fixtures/cal.tif",
   "count": 4,
   "flag": false,
   "mode": "gamma"
  },
  "comment": "every output type; the pixel size follows the calibrated image",
  "expect": {
   "results": {
    "doubled": {
     "shape": [
      32,
      32
     ],
     "dtype": "uint8"
    },
    "rows": {
     "rows": 4,
     "columns": [
      "i",
      "s",
      "scale"
     ]
    },
    "summary": {
     "mode": "gamma",
     "flag": false,
     "had_optional_image": false
    }
   }
  }
 }
